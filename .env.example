# PostgreSQL connection string (add ?sslmode=require when the DB is reached over the network)
DATABASE_URL=postgresql://user:password@host:5432/mosapro

# Secret used to sign admin session tokens. Required, min 32 chars.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Public URL of the server (also used by the Android app build)
SERVER_URL=https://encuestamosapro.thecodersteam.com
